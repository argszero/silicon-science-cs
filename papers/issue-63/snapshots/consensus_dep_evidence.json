 "baidu/braft": {
  "CMakeLists.txt": [
   {
    "signal": "braft",
    "pattern": "\\bbraft\\b|baidu/braft|github\\.com/brpc/braft",
    "lines": [
     "project(braft C CXX)",
     "SET(CPACK_DEBIAN_PACKAGE_MAINTAINER \"braft authors\") #required",
     "file(GLOB BRAFT_PROTOS \"${CMAKE_CURRENT_SOURCE_DIR}/src/braft/*.proto\")"
    ]
   }
  ],
  "src/CMakeLists.txt": [
   {
    "signal": "braft",
    "pattern": "\\bbraft\\b|baidu/braft|github\\.com/brpc/braft",
    "lines": [
     "add_library(braft-shared SHARED $<TARGET_OBJECTS:OBJ_LIB>)",
     "add_library(braft-static STATIC $<TARGET_OBJECTS:OBJ_LIB>)",
     "target_link_libraries(braft-shared ${DYNAMIC_LIB})"
    ]
   }
  ],
  "tools/CMakeLists.txt": [
   {
    "signal": "braft",
    "pattern": "\\bbraft\\b|baidu/braft|github\\.com/brpc/braft",
    "lines": [
     "braft-static",
     "braft-static"
    ]
   }
  ],
  "example/atomic/CMakeLists.txt": [
   {
    "signal": "braft",
    "pattern": "\\bbraft\\b|baidu/braft|github\\.com/brpc/braft",
    "lines": [
     "COMMAND bash -c \"find ${CMAKE_SOURCE_DIR}/../.. -type d -path \\\"*output/include/braft\\\" | xargs dirname | xargs dirname ",
     "find_library(BRAFT_LIB NAMES braft)",
     "find_library(BRAFT_LIB NAMES libbraft.a braft)"
    ]
   }
  ],
  "example/block/CMakeLists.txt": [
   {
    "signal": "braft",
    "pattern": "\\bbraft\\b|baidu/braft|github\\.com/brpc/braft",
    "lines": [
     "COMMAND bash -c \"find ${CMAKE_SOURCE_DIR}/../.. -type d -path \\\"*output/include/braft\\\" | xargs dirname | xargs dirname ",
     "find_library(BRAFT_LIB NAMES braft)",
     "find_library(BRAFT_LIB NAMES libbraft.a braft)"
    ]
   }
  ],
  "example/counter/CMakeLists.txt": [
   {
    "signal": "braft",
    "pattern": "\\bbraft\\b|baidu/braft|github\\.com/brpc/braft",
    "lines": [
     "COMMAND bash -c \"find ${CMAKE_SOURCE_DIR}/../.. -type d -path \\\"*output/include/braft\\\" | xargs dirname | xargs dirname ",
     "find_library(BRAFT_LIB NAMES braft)",
     "find_library(BRAFT_LIB NAMES libbraft.a braft)"
    ]
   }
  ],
  "BUILD": [
   {
    "signal": "braft",
    "pattern": "\\bbraft\\b|baidu/braft|github\\.com/brpc/braft",
    "lines": [
     "load(\":bazel/braft.bzl\", \"braft_proto_library\")",
     "name = \"braft\",",
     "\"src/braft/*.cpp\","
    ]
   }
  ]
 },
